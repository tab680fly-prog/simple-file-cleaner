{
  "app-id": "io.github.filecleaner",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "command": "file-cleaner",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--filesystem=home",
    "--filesystem=/var/log/journal:ro",
    "--filesystem=/var/lib/flatpak:ro",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--talk-name=org.freedesktop.FileManager1",
    "--system-talk-name=org.freedesktop.PolicyKit1"
  ],
  "modules": [
    {
      "name": "file-cleaner",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 file-cleaner.py /app/bin/file-cleaner",
        "install -Dm644 io.github.filecleaner.desktop /app/share/applications/io.github.filecleaner.desktop",
        "install -Dm644 io.github.filecleaner.svg /app/share/icons/hicolor/scalable/apps/io.github.filecleaner.svg",
        "install -Dm644 io.github.filecleaner.metainfo.xml /app/share/metainfo/io.github.filecleaner.metainfo.xml"
      ],
      "sources": [
        {
          "type": "file",
          "path": "src/file-cleaner.py"
        },
        {
          "type": "file",
          "path": "src/io.github.filecleaner.desktop"
        },
        {
          "type": "file",
          "path": "src/io.github.filecleaner.svg"
        },
        {
          "type": "file",
          "path": "src/io.github.filecleaner.metainfo.xml"
        }
      ]
    }
  ]
}
