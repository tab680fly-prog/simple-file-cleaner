{
  "app-id": "io.github.filecleaner",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "command": "file-cleaner",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--filesystem=home",
    "--filesystem=/var/log/journal:ro",
    "--filesystem=/var/lib/flatpak:ro",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--talk-name=org.freedesktop.FileManager1",
    "--system-talk-name=org.freedesktop.PolicyKit1"
  ],
  "modules": [
    {
      "name": "file-cleaner",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_INSTALL_PREFIX=/app"
      ],
      "sources": [
        {
          "type": "file",
          "path": "CMakeLists.txt"
        },
        {
          "type": "dir",
          "path": "src",
          "dest": "src"
        },
        {
          "type": "file",
          "path": "io.github.filecleaner.desktop"
        },
        {
          "type": "file",
          "path": "io.github.filecleaner.svg"
        },
        {
          "type": "file",
          "path": "io.github.filecleaner.metainfo.xml"
        }
      ]
    }
  ]
}
